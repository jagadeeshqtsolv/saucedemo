node_modules/

# Playwright output
test-results/
playwright-report/
logs/*.json
logs/*.html
logs/*.zip
# Archived per-run HTML reports (logs/reports/{runId}/) — a server-side cache for this
# platform's own report viewer, not source — can be dozens of files per run (index.html,
# per-test data JSON, trace .zip, screenshots), none of which belong in the repo.
logs/reports/

