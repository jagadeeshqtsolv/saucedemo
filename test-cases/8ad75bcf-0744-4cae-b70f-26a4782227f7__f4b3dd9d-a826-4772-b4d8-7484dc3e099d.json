    "title": "Smoke: Login → Add Backpack to Cart updates cart icon",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open application URL",
        "value": "https://www.saucedemo.com"
      },
      {
        "id": "s2",
        "action": "fill",
        "targetDescription": "Enter username",
        "screenName": "SwagLabsPage",
        "pageObjectMethod": "fillUsername",
        "value": "standard_user"
      },
      {
        "id": "s3",
        "action": "fill",
        "targetDescription": "Enter password",
        "screenName": "SwagLabsPage",
        "pageObjectMethod": "fillPassword",
        "value": "secret_sauce"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Click Login button",
        "screenName": "SwagLabsPage",
        "pageObjectMethod": "clickLogin"
      },
      {
        "id": "s5",
        "action": "assertVisible",
        "targetDescription": "Verify redirected to Inventory page",
        "screenName": "InventoryPage",
        "pageObjectMethod": "verifyOnPage"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Add 'Sauce Labs Backpack' to cart",
