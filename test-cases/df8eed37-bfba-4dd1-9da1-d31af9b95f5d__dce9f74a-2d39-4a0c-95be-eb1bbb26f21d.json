  "suiteName": "[SCRUM-7] Product Listing & Add to Cart",
  "case": {
    "id": "dce9f74a-2d39-4a0c-95be-eb1bbb26f21d",
    "title": "Invalid sort option is ignored; active option remains default",
    "priority": "P2",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Navigate to application URL",
        "value": "https://www.saucedemo.com/"
      },
      {
        "id": "s2",
        "action": "fill",
        "targetDescription": "Enter username",
        "screenName": "SwagLabsPage",
        "pageObjectMethod": "fillUsername",
        "value": "standard_user"
      },
      {
        "id": "s3",
        "action": "fill",
        "targetDescription": "Enter password",
        "screenName": "SwagLabsPage",
        "pageObjectMethod": "fillPassword",
        "value": "secret_sauce"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Click Login",
        "screenName": "SwagLabsPage",
        "pageObjectMethod": "clickLogin"
      },
      {
        "id": "s5",
        "action": "assertContainsText",
        "targetDescription": "Default active sort is Name (A to Z)",
        "screenName": "InventoryPage",
        "pageObjectMethod": "expectActiveOptionContainsText",
        "assertion": "Name (A to Z)"
      },
      {
        "id": "s6",
        "action": "selectOption",
        "targetDescription": "Attempt to select invalid sort option",
        "locatorHint": "[data-test='product_sort_container']",
        "value": "invalid_option"
      },
      {
        "id": "s7",
        "action": "assertContainsText",
        "targetDescription": "Active sort remains default after invalid selection",
        "screenName": "InventoryPage",
        "pageObjectMethod": "expectActiveOptionContainsText",
        "assertion": "Name (A to Z)"
      }
    ],
    "tags": [
      "@negative",
      "@regression"
    ]
  }
