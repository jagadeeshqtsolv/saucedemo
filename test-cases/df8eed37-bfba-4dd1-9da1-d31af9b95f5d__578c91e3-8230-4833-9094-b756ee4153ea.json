{
  "id": "578c91e3-8230-4833-9094-b756ee4153ea",
  "testPlanId": "df8eed37-bfba-4dd1-9da1-d31af9b95f5d",
  "requirementId": "315320ca-195a-4653-b20c-8a6a94a08e9b",
  "suiteName": "[SCRUM-7] Product Listing & Add to Cart",
  "case": {
    "id": "578c91e3-8230-4833-9094-b756ee4153ea",
    "title": "Login, view & sort products, add to cart, product detail and back",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Navigate to application URL",
        "value": "https://www.saucedemo.com/"
      },
      {
        "id": "s2",
        "action": "fill",
        "targetDescription": "Enter username",
        "screenName": "SwagLabsPage",
        "pageObjectMethod": "fillUsername",
        "value": "standard_user"
      },
      {
        "id": "s3",
        "action": "fill",
        "targetDescription": "Enter password",
        "screenName": "SwagLabsPage",
        "pageObjectMethod": "fillPassword",
        "value": "secret_sauce"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Click Login",
        "screenName": "SwagLabsPage",
        "pageObjectMethod": "clickLogin"
      },
      {
        "id": "s5",
        "action": "assertVisible",
        "targetDescription": "Verify on Inventory page",
        "screenName": "InventoryPage",
        "pageObjectMethod": "verifyOnPage"
      },
      {
        "id": "s6",
        "action": "assertVisible",
        "targetDescription": "Backpack name visible",
        "screenName": "InventoryPage",
        "pageObjectMethod": "expectInventoryItemNameSauceLabsBackpackVisible"
      },
      {
        "id": "s7",
        "action": "assertVisible",
        "targetDescription": "Backpack price visible",
        "screenName": "InventoryPage",
        "pageObjectMethod": "expectInventoryItemPriceSauceLabsBackpackVisible"
      },
      {
        "id": "s8",
        "action": "assertVisible",
        "targetDescription": "Backpack description visible",
        "screenName": "InventoryPage",
        "pageObjectMethod": "expectInventoryItemDescSauceLabsBackpackVisible"
      },
      {
        "id": "s9",
        "action": "assertVisible",
        "targetDescription": "Backpack image visible",
        "screenName": "InventoryPage",
        "pageObjectMethod": "expectItem4ImgVisible"
      },
      {
        "id": "s10",
        "action": "tap",
        "targetDescription": "Open sort dropdown and select Price (Low to High)",
        "screenName": "InventoryPage",
        "pageObjectMethod": "selectProductSort",
        "value": "lohi"
      },
      {
        "id": "s11",
        "action": "assertContainsText",
        "targetDescription": "Verify first product is lowest priced (Onesie)",
        "locatorHint": ".inventory_list .inventory_item:nth-child(1) .inventory_item_name",
        "assertion": "Sauce Labs Onesie"
      },
      {
        "id": "s12",
        "action": "tap",
        "targetDescription": "Add Backpack to cart",
        "screenName": "InventoryPage",
        "pageObjectMethod": "clickAddToCartSauceLabsBackpackSauceLabsBackpack"
      },
      {
        "id": "s13",
        "action": "assertContainsText",
        "targetDescription": "Cart badge updated to 1",
        "locatorHint": ".shopping_cart_badge",
        "assertion": "1"
      },
      {
        "id": "s14",
        "action": "tap",
        "targetDescription": "Open Backpack product detail via name",
        "screenName": "InventoryPage",
        "pageObjectMethod": "clickInventoryItemNameSauceLabsBackpack"
      },
      {
        "id": "s15",
        "action": "assertContainsText",
        "targetDescription": "Verify product detail name",
        "locatorHint": ".inventory_details_name",
        "assertion": "Sauce Labs Backpack"
      },
      {
        "id": "s16",
        "action": "tap",
        "targetDescription": "Back to products",
        "locatorHint": "#back-to-products"
      },
      {
        "id": "s17",
        "action": "assertVisible",
        "targetDescription": "Verify back on Inventory page",
        "screenName": "InventoryPage",
        "pageObjectMethod": "verifyOnPage"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
