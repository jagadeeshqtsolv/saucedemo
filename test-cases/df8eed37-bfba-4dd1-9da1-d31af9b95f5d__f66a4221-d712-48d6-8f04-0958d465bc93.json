{
  "id": "f66a4221-d712-48d6-8f04-0958d465bc93",
  "testPlanId": "df8eed37-bfba-4dd1-9da1-d31af9b95f5d",
  "requirementId": "315320ca-195a-4653-b20c-8a6a94a08e9b",
  "suiteName": "[SCRUM-7] Product Listing & Add to Cart",
  "case": {
    "id": "f66a4221-d712-48d6-8f04-0958d465bc93",
    "title": "Add then remove from listing; cart badge updates accordingly",
    "priority": "P1",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Navigate to application URL",
        "value": "https://www.saucedemo.com/"
      },
      {
        "id": "s2",
        "action": "fill",
        "targetDescription": "Enter username",
        "screenName": "SwagLabsPage",
        "pageObjectMethod": "fillUsername",
        "value": "standard_user"
      },
      {
        "id": "s3",
        "action": "fill",
        "targetDescription": "Enter password",
        "screenName": "SwagLabsPage",
        "pageObjectMethod": "fillPassword",
        "value": "secret_sauce"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Click Login",
        "screenName": "SwagLabsPage",
        "pageObjectMethod": "clickLogin"
      },
      {
        "id": "s5",
        "action": "tap",
        "targetDescription": "Add Backpack to cart",
        "screenName": "InventoryPage",
        "pageObjectMethod": "clickAddToCartSauceLabsBackpackSauceLabsBackpack"
      },
      {
        "id": "s6",
        "action": "assertContainsText",
        "targetDescription": "Cart badge shows 1",
        "locatorHint": ".shopping_cart_badge",
        "assertion": "1"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Remove Backpack from cart (from listing)",
        "screenName": "InventoryPage",
        "pageObjectMethod": "clickRemoveSauceLabsBackpackSauceLabsBackpack"
      },
      {
        "id": "s8",
        "action": "assertHidden",
        "targetDescription": "Cart badge removed",
        "locatorHint": ".shopping_cart_badge"
      },
      {
        "id": "s9",
        "action": "assertVisible",
        "targetDescription": "Add to cart button visible again for Backpack",
        "screenName": "InventoryPage",
        "pageObjectMethod": "expectAddToCartSauceLabsBackpackSauceLabsBackpackVisible"
      }
    ],
    "tags": [
      "@e2e",
      "@regression"
    ]
  }
}
